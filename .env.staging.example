# =============================================================================
# STAGING ENVIRONMENT - Backend (Render service: mountaineer-crew-app-staging)
# Copy this file's values into your Render staging service's Environment tab.
# =============================================================================

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string from your Supabase STAGING project.
# Dashboard → Project Settings → Database → Connection string (URI mode).
# Replace "postgres://" with "postgresql://" - SQLAlchemy requires it.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[STAGING-PROJECT-REF].supabase.co:5432/postgres

# ── Auth / JWT ────────────────────────────────────────────────────────────────
# Generate a fresh secret - do NOT reuse production's JWT_SECRET.
# Command: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_WITH_NEW_RANDOM_64_CHAR_HEX

# Token lifetime in minutes (10080 = 7 days). Lower for staging if desired.
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Admin ─────────────────────────────────────────────────────────────────────
# Email that gets auto-promoted to admin on every backend startup.
ADMIN_EMAIL=your-email@example.com

# ── Frontend URL (used in password-reset emails) ───────────────────────────────
# Set this to your Vercel staging deployment URL once it exists.
FRONTEND_URL=https://mountaineer-crew-app-staging.vercel.app

# ── Email / Postmark ──────────────────────────────────────────────────────────
# Use the same Postmark server token as prod (it's account-level, not env-level)
# OR create a separate Postmark sandbox server for staging.
POSTMARK_SERVER_TOKEN=REPLACE_WITH_POSTMARK_SERVER_TOKEN
SMTP_FROM=noreply@yourdomain.com

# ── Google OAuth / Calendar ───────────────────────────────────────────────────
# Full JSON of the service-account / OAuth token blob.
# Staging can share the same Google service account as prod, but point to a
# separate staging calendar (WORKSPACE_CALENDAR_ID below).
GOOGLE_OAUTH_TOKEN_JSON={"token": "...", "refresh_token": "...", ...}

# Google Calendar ID for the STAGING calendar.
# Create a new calendar in Google Calendar and copy its ID from settings.
WORKSPACE_CALENDAR_ID=staging-calendar-id@group.calendar.google.com

# ── Google Sheets ─────────────────────────────────────────────────────────────
# Staging and production share ONE spreadsheet and are kept apart by TAB NAME,
# not by a separate file. See docs/decisions/0003-staging-prod-sheet-tab-split.md.
GOOGLE_SHEETS_SPREADSHEET_ID=1KDWNudFSc8tlqV7lzq-M235swkgq7jWg_63ilrw_9hk

# Tab names. EVERY ONE OF THESE MUST BE SET ON STAGING.
#
# These are not optional niceties. Each var defaults to the PRODUCTION tab name
# when it is unset (see SHEET_SYNC_REGISTRY in sheets_export.py), so a staging
# deploy missing one of them writes crew test data straight into the office's
# real worksheet, silently and with no error. Adding a new sheet sync means
# adding its var here in the same commit.
#
# Admin > Advanced Settings > System Check > Sheet Syncs lists every sync and
# flags the ones falling back to a default tab. Check it after a deploy.
SHEETS_EVENTS_TAB=EventsStaging
SHEETS_MATERIALS_TAB=MaterialsStaging
SHEETS_JOB_REPORTS_TAB=JobReportsStaging
SHEETS_BILLS_TAB=BillsStaging
SHEETS_ESTIMATES_TAB=EstimatesStaging
SHEETS_ESTIMATE_ITEMS_TAB=EstimateItemsStaging
SHEETS_BOLS_TAB=BOLsStaging
SHEETS_BOL_ITEMS_TAB=BOLItemsStaging
SHEETS_JOB_INVENTORY_TAB=JobInventoryStaging
SHEETS_JOB_INVENTORY_ITEMS_TAB=JobInventoryItemsStaging
SHEETS_INCIDENTS_TAB=IncidentsStaging
SHEETS_DVIRS_TAB=DVIRsStaging
SHEETS_PRIOR_HOURS_TAB=PriorOnDutyStaging
SHEETS_RODS_TAB=RODSStaging
SHEETS_LD_PAY_TAB=LongDistancePayStaging
SHEETS_OFFICE_HOURS_TAB=OfficeHoursStaging
SHEETS_REIMBURSEMENTS_TAB=ReimbursementsStaging
SHEETS_AVAILABILITY_TAB=AvailabilityStaging
SHEETS_OFF_JOB_TAB=OffJobHoursStaging

# ── Google Drive ──────────────────────────────────────────────────────────────
# Folder name under which staging job photos are stored in Drive.
# Using a different name keeps staging photos clearly separated from prod.
DRIVE_PARENT_FOLDER_NAME=Mountaineer Crew Photos (Staging)

# Folder name for the Document Library AND the Driver Qualification (DQ) files
# (medical cards, employment applications - PII). Load-bearing: without a staging
# override, staging resolves "Mountaineer Crew Documents" BY NAME - the same
# folder prod uses - so staging test DQ files land in the real drivers' folders.
# A staging-only name keeps them separated. (C4 / DQ.)
DRIVE_DOCUMENTS_FOLDER_NAME=Mountaineer Crew Documents (Staging)

# Signed BOL PDFs go here. Set a folder ID (the segment after /folders/ in the
# Drive URL) to a STAGING-ONLY folder. This is load-bearing: without it, staging
# resolves the signed-BOL folder BY NAME ("Signed Bills of Lading") - the same
# name production uses - so staging writes into, and can overwrite in place, the
# real signed legal documents. Create a separate staging folder, put its ID here,
# and set a DIFFERENT prod folder ID on the prod Render service. (ADR 0020.)
DRIVE_BOL_FOLDER_ID=

# ── Google Maps (optional) ────────────────────────────────────────────────────
# Powers the return-trip drive time and the address lookup in the wrap-up
# estimator. Needs Directions + Places enabled on the same GCP project.
#
# It FAILS SOFT, which is the trap: with no key the endpoints return
# {ok: false, reason: "no_api_key"} and the UI quietly falls back to manual
# entry. Nothing errors, nothing is lost, and the feature simply does not work
# while looking like it is merely finding nothing. If the crew report that
# address lookup "does nothing", check this first.
#
# GOOGLE_MAPS_API_KEY is the real name; MAPS_API_KEY is accepted as a fallback.
# GOOGLE_MAPS_API_KEY=

# Default destination for the return-trip estimate. Already defaults to the
# Bozeman yard in code, so only set this if the yard address changes.
# DISPATCH_ADDRESS=172 Timberline Dr, Bozeman, MT

# ── SQLite fallback (local dev only - not needed on Render) ───────────────────
# SQLITE_PATH=./app.db
