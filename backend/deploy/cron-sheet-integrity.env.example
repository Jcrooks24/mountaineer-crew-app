# Render Cron Job env for backend/scripts/sheet_integrity_check.py
# (the nightly Google Sheet integrity check; alerts email ALERT_EMAIL on FAIL).
#
# HOW TO USE
#   Non-secret values below are the real prod values - copy them straight into
#   the Cron Job's Environment tab (or "Add from .env").
#   The three SECRETS are intentionally NOT in this repo (CREDENTIALS.md: no
#   secret values, ever). Get them once by linking the SAME Render Environment
#   Group your prod backend uses to this Cron Job - then they stay in sync and
#   you never retype them.
#
# Cron Job settings that go with this:
#   Branch:          staging   (the script lives here until the next main promotion)
#   Root Directory:  backend
#   Command:         python scripts/sheet_integrity_check.py
#   Schedule:        0 5 * * *   (daily ~11pm MT; Render cron is UTC)

# --- SECRETS: do NOT paste real values here. Link the prod backend's
#     Environment Group instead (Cron Job -> Environment -> Link Environment Group). ---
# DATABASE_URL=            # prod Postgres (used only to read the Google OAuth token)
# POSTMARK_SERVER_TOKEN=   # prod Postmark server token
# SMTP_FROM=               # verified Postmark sender address

# --- non-secret: safe to commit, copy as-is ---
GOOGLE_SHEETS_SPREADSHEET_ID=1KDWNudFSc8tlqV7lzq-M235swkgq7jWg_63ilrw_9hk
ALERT_EMAIL=jacob@mountaineermoving.com

# The four camelCase prod tabs - REQUIRED, or the check reads the empty
# PascalCase tabs and misses real drift. All other SHEETS_*_TAB vars can stay
# unset (they default to the correct prod names).
SHEETS_INCIDENTS_TAB=incidents
SHEETS_JOB_INVENTORY_TAB=jobInventory
SHEETS_JOB_INVENTORY_ITEMS_TAB=jobInventoryItems
SHEETS_OFF_JOB_TAB=offJob
